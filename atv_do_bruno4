import java.util.Scanner;

public class Separador {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] pos = new int[8], neg = new int[8];
        int qP = 0, qN = 0;

        System.out.println("Digite 8 números:");
        for (int i = 0; i < 8; i++) {
            int n = sc.nextInt();
            if (n >= 0) pos[qP++] = n;
            else neg[qN++] = n;
        }

        System.out.print("Positivos: ");
        for (int i = 0; i < qP; i++) System.out.print(pos[i] + " ");
        
        System.out.print("\nNegativos: ");
        for (int i = 0; i < qN; i++) System.out.print(neg[i] + " ");
        
        sc.close();
    }
}
